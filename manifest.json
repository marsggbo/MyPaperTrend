{
  "manifest_version": 3,
  "name": "MyPaperTrend",
  "version": "0.7.0",
  "key": "",
  "description": "Track your Google Scholar citations over time and overlay the trend chart right on your Scholar profile. Zero-config, local-first.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "identity"
  ],
  "host_permissions": [
    "https://scholar.google.com/*",
    "https://github.com/*",
    "https://api.github.com/*",
    "https://api.semanticscholar.org/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/ui/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://scholar.google.com/citations*"
      ],
      "js": [
        "src/vendor/chart.umd.min.js",
        "src/core/i18n.js",
        "src/core/schema.js",
        "src/core/normalizer.js",
        "src/core/settings.js",
        "src/core/storage/local.js",
        "src/content/scholar_dom.js",
        "src/content/chart_util.js",
        "src/content/overlay.js",
        "src/content/inline.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "oauth2": {
    "client_id": "490407427089-31q855a57gae0n3h1c753n44sp087lp1.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  }
}